{
  "name": "myl1-mobile-wallet",
  "version": "1.0.0",
  "description": "MyL1 Mobile Wallet - Modern React Native wallet for iOS and Android",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint .",
    "setup": "./setup-project.sh",
    "build:apk": "./build-apk.sh",
    "build:apk:debug": "cd android && ./gradlew assembleDebug && cd ..",
    "build:apk:release": "cd android && ./gradlew assembleRelease && cd ..",
    "clean": "./clean-build.sh",
    "fix:deps": "./fix-rn-compat.sh",
    "setup:java": "./install-java.sh",
    "setup:java17": "./install-java17.sh",
    "postinstall": "cd ios && pod install && cd .. || true"
  },
  "dependencies": {
    "@polkadot/api": "^12.0.0",
    "@polkadot/extension-dapp": "^0.62.6",
    "@polkadot/keyring": "^12.6.2",
    "@polkadot/util": "^12.6.2",
    "@polkadot/util-crypto": "^12.6.2",
    "@polkadot/x-global": "^14.0.1",
    "@react-native-async-storage/async-storage": "^1.19.5",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "base-64": "^1.0.0",
    "bip39": "^3.1.0",
    "buffer": "^6.0.3",
    "process": "^0.11.10",
    "react": "18.2.0",
    "react-native": "0.72.6",
    "react-native-biometrics": "^3.0.1",
    "react-native-crypto": "^2.2.1",
    "react-native-gesture-handler": "^2.12.1",
    "react-native-get-random-values": "^2.0.0",
    "react-native-keychain": "^8.1.3",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-polyfill-globals": "^3.1.0",
    "react-native-qrcode-svg": "^6.2.0",
    "react-native-reanimated": "~3.3.0",
    "react-native-safe-area-context": "^4.7.4",
    "react-native-screens": "^3.25.0",
    "react-native-svg": "^14.1.0",
    "react-native-vector-icons": "^10.0.2",
    "text-encoding": "^0.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/plugin-transform-class-static-block": "^7.22.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/eslint-config": "^0.72.2",
    "@react-native/metro-config": "^0.72.11",
    "@tsconfig/react-native": "^3.0.0",
    "@types/react": "^18.0.24",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.2.1",
    "eslint": "^8.19.0",
    "jest": "^29.2.1",
    "metro-react-native-babel-preset": "0.76.8",
    "prettier": "^2.4.1",
    "react-test-renderer": "18.2.0",
    "typescript": "^4.8.4"
  },
  "engines": {
    "node": ">=16"
  }
}
